# Copy to .env and fill in. Set ONE of the two API keys below to enable the AI
# features (resume tailoring, fit review, interview prep). The rest of the app —
# searching, scoring, importing, tracking — works with no key at all.

# Option A: Anthropic Claude. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Option B: Google Gemini — has a genuinely free tier, no credit card.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides
# LLM_PROVIDER=gemini          # force a backend when both keys are set
# ANTHROPIC_MODEL=claude-opus-5
# GEMINI_MODEL=gemini-2.0-flash
# JOB_APPLIER_HOST=127.0.0.1
# JOB_APPLIER_PORT=8765
# JOB_APPLIER_DATA=./data

# Chromium used to fill application forms. Playwright manages its own browser,
# so leave this unset unless it reports "Executable doesn't exist at ...".
# JOB_APPLIER_BROWSER_PATH=/path/to/chrome
